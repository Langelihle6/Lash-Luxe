"use client"

import { useState } from "react"
import { useRouter } from "next/navigation"
import { EyelashLogo } from "@/components/eyelash-logo"
import { Button } from "@/components/ui/button"
import { Card } from "@/components/ui/card"
import { useBookingStore, type ServiceType, type LengthType } from "@/lib/booking-store"
import { Check, ArrowLeft } from "lucide-react"

const services = [
  {
    id: "classic" as ServiceType,
    name: "Classic",
    price: 220,
    description: "One extension per natural lash for a natural, elegant look",
    image: "/classic-eyelash-extensions.jpg",
  },
  {
    id: "hybrid" as ServiceType,
    name: "Hybrid",
    price: 250,
    description: "Mix of classic and volume for the perfect balance",
    image: "/hybrid-eyelash-extensions.jpg",
  },
  {
    id: "cat-eye" as ServiceType,
    name: "Cat Eye",
    price: 270,
    description: "Elongated outer corners for a dramatic, sultry effect",
    image: "/cat-eye-eyelash-extensions.jpg",
  },
  {
    id: "volume" as ServiceType,
    name: "Volume",
    price: 300,
    description: "Multiple extensions per lash for full, glamorous volume",
    image: "/volume-eyelash-extensions.png",
  },
]

const lengths = [
  { id: "short" as LengthType, name: "Short", description: "Natural everyday look" },
  { id: "medium" as LengthType, name: "Medium", description: "Perfect balance" },
  { id: "long" as LengthType, name: "Long", description: "Dramatic impact" },
]

export default function ServicesPage() {
  const router = useRouter()
  const { setService } = useBookingStore()
  const [selectedService, setSelectedService] = useState<ServiceType | null>(null)
  const [selectedLength, setSelectedLength] = useState<LengthType | null>(null)

  const handleContinue = () => {
    if (selectedService && selectedLength) {
      setService(selectedService, selectedLength)
      router.push("/booking/datetime")
    }
  }

  const selectedServiceData = services.find((s) => s.id === selectedService)

  return (
    <div className="min-h-screen bg-gradient-to-br from-background via-secondary/20 to-background">
      {/* Header */}
      <header className="border-b border-border/50 bg-card/80 backdrop-blur-sm sticky top-0 z-40">
        <div className="container mx-auto px-4 py-4">
          <div className="flex items-center justify-between">
            <Button variant="ghost" size="sm" onClick={() => router.push("/")} className="gap-2">
              <ArrowLeft className="w-4 h-4" />
              Back
            </Button>
            <div className="flex items-center gap-3">
              <EyelashLogo className="w-12 h-6 text-primary" />
              <h1 className="text-xl font-bold text-primary">Lash Luxe</h1>
            </div>
            <div className="w-20" />
          </div>
        </div>
      </header>

      <main className="container mx-auto px-4 py-12 max-w-6xl">
        {/* Progress Steps */}
        <div className="flex items-center justify-center gap-2 mb-12">
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 rounded-full bg-primary text-primary-foreground flex items-center justify-center font-bold">
              1
            </div>
            <span className="text-sm font-medium hidden sm:inline">Service</span>
          </div>
          <div className="w-12 h-0.5 bg-border" />
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 rounded-full bg-muted text-muted-foreground flex items-center justify-center font-bold">
              2
            </div>
            <span className="text-sm font-medium text-muted-foreground hidden sm:inline">Date & Time</span>
          </div>
          <div className="w-12 h-0.5 bg-border" />
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 rounded-full bg-muted text-muted-foreground flex items-center justify-center font-bold">
              3
            </div>
            <span className="text-sm font-medium text-muted-foreground hidden sm:inline">Details</span>
          </div>
          <div className="w-12 h-0.5 bg-border" />
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 rounded-full bg-muted text-muted-foreground flex items-center justify-center font-bold">
              4
            </div>
            <span className="text-sm font-medium text-muted-foreground hidden sm:inline">Payment</span>
          </div>
        </div>

        <div className="text-center space-y-2 mb-12">
          <h2 className="text-3xl md:text-4xl font-bold">Choose Your Lash Style</h2>
          <p className="text-muted-foreground text-lg">Select the service and length that's perfect for you</p>
        </div>

        {/* Service Selection */}
        <div className="space-y-8">
          <div>
            <h3 className="text-xl font-bold mb-6">Step 1: Select Your Service</h3>
            <div className="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {services.map((service) => (
                <Card
                  key={service.id}
                  className={`cursor-pointer transition-all hover:shadow-lg ${
                    selectedService === service.id
                      ? "ring-2 ring-primary border-primary shadow-lg"
                      : "border-border hover:border-primary/50"
                  }`}
                  onClick={() => setSelectedService(service.id)}
                >
                  <div className="p-0 relative">
                    <img
                      src={service.image || "/placeholder.svg"}
                      alt={service.name}
                      className="w-full h-40 object-cover rounded-t-xl"
                    />
                    {selectedService === service.id && (
                      <div className="absolute top-2 right-2 w-6 h-6 bg-primary rounded-full flex items-center justify-center">
                        <Check className="w-4 h-4 text-primary-foreground" />
                      </div>
                    )}
                    <div className="p-4 space-y-2">
                      <h4 className="font-bold text-lg">{service.name}</h4>
                      <p className="text-2xl font-bold text-primary">R{service.price}</p>
                      <p className="text-sm text-muted-foreground">{service.description}</p>
                    </div>
                  </div>
                </Card>
              ))}
            </div>
          </div>

          {/* Length Selection */}
          {selectedService && (
            <div className="animate-in fade-in slide-in-from-bottom-4 duration-500">
              <h3 className="text-xl font-bold mb-6">Step 2: Select Your Length</h3>
              <div className="grid sm:grid-cols-3 gap-4 max-w-3xl">
                {lengths.map((length) => (
                  <Card
                    key={length.id}
                    className={`cursor-pointer transition-all hover:shadow-lg ${
                      selectedLength === length.id
                        ? "ring-2 ring-primary border-primary shadow-lg"
                        : "border-border hover:border-primary/50"
                    }`}
                    onClick={() => setSelectedLength(length.id)}
                  >
                    <div className="p-6 space-y-2 relative">
                      {selectedLength === length.id && (
                        <div className="absolute top-4 right-4 w-6 h-6 bg-primary rounded-full flex items-center justify-center">
                          <Check className="w-4 h-4 text-primary-foreground" />
                        </div>
                      )}
                      <h4 className="font-bold text-lg">{length.name}</h4>
                      <p className="text-sm text-muted-foreground">{length.description}</p>
                    </div>
                  </Card>
                ))}
              </div>
            </div>
          )}

          {/* Summary and Continue */}
          {selectedService && selectedLength && (
            <div className="animate-in fade-in slide-in-from-bottom-4 duration-500">
              <Card className="bg-primary/5 border-primary/20 p-6 max-w-2xl mx-auto">
                <div className="space-y-4">
                  <h3 className="text-xl font-bold">Your Selection</h3>
                  <div className="flex justify-between items-center">
                    <div>
                      <p className="font-medium">{selectedServiceData?.name} Lashes</p>
                      <p className="text-sm text-muted-foreground capitalize">{selectedLength} length</p>
                    </div>
                    <p className="text-2xl font-bold text-primary">R{selectedServiceData?.price}</p>
                  </div>
                  <div className="pt-4 border-t border-border">
                    <p className="text-sm text-muted-foreground mb-4">
                      A 50% deposit (R{selectedServiceData ? selectedServiceData.price * 0.5 : 0}) will be required to
                      secure your booking
                    </p>
                    <Button
                      onClick={handleContinue}
                      className="w-full bg-primary hover:bg-primary/90 text-primary-foreground py-6 text-lg rounded-full"
                      size="lg"
                    >
                      Continue to Date & Time
                    </Button>
                  </div>
                </div>
              </Card>
            </div>
          )}
        </div>
      </main>
    </div>
  )
}
